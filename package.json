    "devDependencies": {
        "@changesets/cli": "^3.0.0",
        "@tsconfig/node18": "^18.2.6",
        "@tsconfig/strictest": "^2.0.8",
        "@types/foreground-child": "^2.0.2",
        "@types/node": "^18.19.130",
        "dprint": "^0.55.2",
        "oxlint": "^1.78.0",
        "oxlint-tsgolint": "^7.0.2001",
        "rimraf": "^6.1.3",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "@datadog/pprof@5.15.1": true,
        "dprint@0.55.2": true
    },
    "packageManager": "npm@12.1.0+sha512.17286eeb6a4dc7bd180acff9f9d1262504c556648ac2fa39080d2abc19060d1a686f8d8c27a1b6450dad77178a3389d89c8643aa4600c4482ab687a39fd406b5"
