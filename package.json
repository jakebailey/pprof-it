{
    "name": "pprof-it",
    "version": "4.1.0",
    "description": "Handy wrapper for pprof",
    "repository": "https://github.com/jakebailey/pprof-it",
    "author": "Jake Bailey",
    "license": "MIT",
    "engines": {
        "node": ">=18"
    },
    "bin": "dist/main.js",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "LICENSE.txt"
    ],
    "scripts": {
        "build": "tsc",
        "watch": "tsc --watch",
        "lint": "oxlint .",
        "test": "node test.js",
        "prepack": "rimraf dist && npm run build",
        "version": "changeset version && npm install"
