        "dprint": "^0.55.2",
        "oxlint": "^1.78.0",
        "oxlint-tsgolint": "^7.0.2001",
        "rimraf": "^6.1.3",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "@datadog/pprof@5.15.1": true,
